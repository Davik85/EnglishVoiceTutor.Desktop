<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/LessonPolicies/**/*.cs" Link="Shared/LessonPolicies/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Shared/StudyLanguages/**/*.cs" Link="Shared/StudyLanguages/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Shared/NativeLanguages/**/*.cs" Link="Shared/NativeLanguages/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Models/LessonContent/**/*.cs" Link="Models/LessonContent/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Models/TutorAvatarOption.cs" Link="Models/TutorAvatarOption.cs" />
    <Compile Include="../../Models/TutorAvatarOptions.cs" Link="Models/TutorAvatarOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../Content/Lessons/**/*.json" Link="Content/Lessons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Content/Prompts/**/*.txt" Link="Content/Prompts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Content/Tutors/**/*.json" Link="Content/Tutors/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Content/StudyLanguages/**/*.json" Link="Content/StudyLanguages/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Google.Apis.AndroidPublisher.v3" Version="1.75.0.4215" />
  </ItemGroup>

</Project>
