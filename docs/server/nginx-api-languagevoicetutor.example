# Example nginx site for the future Language Voice Tutor API reverse proxy.
# Keep this API site separate from the existing static languagevoicetutor.com site.
# Certbot can later modify this config to add TLS for api.languagevoicetutor.com.

server {
    listen 80;
    listen [::]:80;
    server_name api.languagevoicetutor.com;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300;
    }
}
