# Language Voice Tutor backend environment template for Ubuntu 24.04.
# Copy this documentation-only template to the server as:
#   /etc/languagevoicetutor/backend.env
# Keep the real file outside git and readable only by the deploy/service account.
# Replace every placeholder before starting the service. Never commit real secrets.

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5001

# PostgreSQL connection string used by Program.cs via GetConnectionString("DefaultConnection").
# PostgreSQL is expected to already contain database lvt_app_db and app user lvt_app.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=lvt_app_db;Username=lvt_app;Password=<database-password>

# Required by backend JWT authentication startup validation. Use a long random value, at least 32 characters.
Jwt__Issuer=EnglishVoiceTutor.Api
Jwt__Audience=EnglishVoiceTutor.Desktop
Jwt__SigningKey=<replace-with-long-random-jwt-signing-key>
Jwt__AccessTokenLifetimeMinutes=60

# Backend-only OpenAI key. The desktop app must never store or call this key directly.
OPENAI_API_KEY=<openai-api-key-for-backend-only>
OpenAI__Model=gpt-5.2

# Production billing remains deferred for this test deployment.
SubscriptionEnforcement__Enabled=false
Billing__CheckoutEnabled=false
Billing__Provider=none
Billing__SuccessUrl=
Billing__CancelUrl=
PaddleBilling__CheckoutAdapterEnabled=false
PaddleWebhook__Enabled=false

# Optional bootstrap access for test admin work only. Leave disabled unless explicitly needed.
AdminBootstrap__Enabled=false
# Example array syntax for a real server env file if enabled later:
# AdminBootstrap__AdminEmails__0=admin@example.com

# CMS runtime remains static-json fallback by default. Enable published-snapshot runtime only deliberately.
CmsContent__ReadPublishedSnapshotEnabled=false
CmsContent__UsePublishedSnapshotForRuntime=false
CmsContent__ContentPackSlug=static-json-v1
CmsContent__FallbackToStaticJson=true

# CORS is not currently configured by the backend. Nginx should proxy API traffic to localhost.
