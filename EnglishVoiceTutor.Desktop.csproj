<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>Language Voice Tutor</Product>
    <AssemblyTitle>Language Voice Tutor Desktop</AssemblyTitle>
    <Description>Language Voice Tutor Desktop</Description>
    <Version>0.0.0-local</Version>
    <InformationalVersion>0.0.0-local</InformationalVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DesktopBackendBaseUrl Condition="'$(DesktopBackendBaseUrl)' == ''">http://localhost:5000</DesktopBackendBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="backend/**/*.cs" />
    <EmbeddedResource Remove="backend/**/*" />
    <None Remove="backend/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets/Avatars/**/*.gif" />
    <None Remove="Assets/Welcome/**/*.png" />
    <Resource Include="Assets/Avatars/**/*.gif" />
    <Resource Include="Assets/Welcome/**/*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateDesktopBackendBaseUrl" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DesktopBackendBaseUrl)', '^https?://\S+$'))" Text="DesktopBackendBaseUrl must be an absolute http/https URL." />
  </Target>

  <Target Name="GenerateDesktopBackendBuildSettings" BeforeTargets="BeforeCompile" DependsOnTargets="ValidateDesktopBackendBaseUrl">
    <PropertyGroup>
      <DesktopBackendBuildSettingsFile>$(IntermediateOutputPath)DesktopBackendBuildSettings.g.cs</DesktopBackendBuildSettingsFile>
    </PropertyGroup>
    <ItemGroup>
      <DesktopBackendBuildSettingsLine Include="// &lt;auto-generated /&gt;" />
      <DesktopBackendBuildSettingsLine Include="namespace EnglishVoiceTutor.Desktop.Constants;" />
      <DesktopBackendBuildSettingsLine Include="internal static class DesktopBackendBuildSettings" />
      <DesktopBackendBuildSettingsLine Include="{" />
      <DesktopBackendBuildSettingsLine Include="    public const string DefaultBackendBaseUrl = &quot;$(DesktopBackendBaseUrl)&quot;;" />
      <DesktopBackendBuildSettingsLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(DesktopBackendBuildSettingsFile)" Lines="@(DesktopBackendBuildSettingsLine)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(DesktopBackendBuildSettingsFile)" AutoGen="true" DesignTime="true" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.1" />
  </ItemGroup>

</Project>
