<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LanguageVoiceTutor.Desktop</AssemblyName>
    <Product>Language Voice Tutor</Product>
    <AssemblyTitle>Language Voice Tutor Desktop</AssemblyTitle>
    <Description>Language Voice Tutor Desktop</Description>
    <Version>1.0</Version>
    <InformationalVersion>1.0</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppIconPath>Assets\Branding\app-icon.ico</AppIconPath>
    <ApplicationIcon Condition="Exists('$(AppIconPath)')">$(AppIconPath)</ApplicationIcon>
    <DesktopBackendBaseUrl Condition="'$(DesktopBackendBaseUrl)' == '' and '$(Configuration)' == 'Debug'">http://localhost:5000</DesktopBackendBaseUrl>
    <DesktopBackendBaseUrl Condition="'$(DesktopBackendBaseUrl)' == '' and '$(Configuration)' != 'Debug'">https://api.languagevoicetutor.com</DesktopBackendBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="backend/**/*.cs" />
    <EmbeddedResource Remove="backend/**/*" />
    <None Remove="backend/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets/Avatars/**/*.gif" />
    <None Remove="Assets/Welcome/**/*.png" />
    <Resource Include="Assets/Avatars/**/*.gif" />
    <Resource Include="Assets/Welcome/**/*.png" />
    <Resource Include="$(AppIconPath)" Condition="Exists('$(AppIconPath)')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateDesktopBackendBaseUrl" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DesktopBackendBaseUrl)', '^https?://\S+$'))" Text="DesktopBackendBaseUrl must be an absolute http/https URL." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(DesktopBackendBaseUrl)' != 'https://api.languagevoicetutor.com'" Text="Non-Debug desktop builds are server-only and must use https://api.languagevoicetutor.com." />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopBackendBaseUrl</_Parameter1>
      <_Parameter2>$(DesktopBackendBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.1" />
  </ItemGroup>

</Project>
