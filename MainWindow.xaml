<Window x:Class="EnglishVoiceTutor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EnglishVoiceTutor.Desktop.ViewModels"
        xmlns:views="clr-namespace:EnglishVoiceTutor.Desktop.Views"
        mc:Ignorable="d"
        Title="Language Voice Tutor Desktop"
        Width="760"
        Height="800"
        MinWidth="680"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FlowDirection="{Binding AppFlowDirection}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="AccessPanelOverlayBrush" Color="#66000000" />
        <DataTemplate DataType="{x:Type viewModels:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LevelSelectionViewModel}">
            <views:LevelSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SubtopicsViewModel}">
            <views:SubtopicsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LessonChatViewModel}">
            <views:LessonChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LessonSummaryViewModel}">
            <views:LessonSummaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LessonHistoryViewModel}">
            <views:LessonHistoryView />
        </DataTemplate>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource FrameBorderBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="10">
        <Grid>
            <ContentControl Content="{Binding CurrentViewModel}" />

            <Border Panel.ZIndex="10"
                    Background="{StaticResource AccessPanelOverlayBrush}"
                    CornerRadius="18"
                    Visibility="{Binding IsAccessPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="460"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource MainContentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding AccessPanelTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AccessPanelMessage}"
                                   Margin="0,14,0,0"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   LineHeight="22"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,24,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="{Binding AccessPanelPrimaryActionText}"
                                    Margin="0,0,10,0"
                                    Command="{Binding AccessPanelPrimaryActionCommand}"
                                    IsEnabled="{Binding IsAccessPanelPrimaryActionEnabled}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding IsAccessPanelPrimaryActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="{Binding AccessPanelRefreshActionText}"
                                    Margin="0,0,10,0"
                                    Command="{Binding RefreshAccessStatusCommand}"
                                    IsEnabled="{Binding IsAccessPanelRefreshActionEnabled}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding IsAccessPanelRefreshActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="{Binding AccessPanelCloseActionText}"
                                    Command="{Binding CloseAccessPanelCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
