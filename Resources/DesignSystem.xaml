<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#FFF6F8FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceSoftColor">#FFFBFCFE</Color>
    <Color x:Key="TextPrimaryColor">#FF1C2B3A</Color>
    <Color x:Key="TextSecondaryColor">#FF3A4A5B</Color>
    <Color x:Key="AccentColor">#FF1E3A56</Color>
    <Color x:Key="AccentHoverColor">#FF2B4C70</Color>
    <Color x:Key="AccentPressedColor">#FF17304D</Color>
    <Color x:Key="BorderSoftColor">#FFE1E8F0</Color>
    <Color x:Key="BorderAccentSoftColor">#FFCAD8E6</Color>
    <Color x:Key="FrameBorderColor">#FFBFDDF4</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="BorderAccentSoftBrush" Color="{StaticResource BorderAccentSoftColor}" />
    <SolidColorBrush x:Key="FrameBorderBrush" Color="{StaticResource FrameBorderColor}" />

    <CornerRadius x:Key="CornerSmall">10</CornerRadius>
    <CornerRadius x:Key="CornerMedium">13</CornerRadius>
    <CornerRadius x:Key="CornerLarge">18</CornerRadius>
    <Thickness x:Key="ButtonPadding">18,8,18,8</Thickness>

    <SolidColorBrush x:Key="LevelA1BackgroundBrush" Color="#FFEAF8EE" />
    <SolidColorBrush x:Key="LevelA1BorderBrush" Color="#FFBFE8CB" />
    <SolidColorBrush x:Key="LevelA2BackgroundBrush" Color="#FFE7F8F5" />
    <SolidColorBrush x:Key="LevelA2BorderBrush" Color="#FFB9E5DE" />
    <SolidColorBrush x:Key="LevelB1BackgroundBrush" Color="#FFFFF6D8" />
    <SolidColorBrush x:Key="LevelB1BorderBrush" Color="#FFF0D88A" />
    <SolidColorBrush x:Key="LevelB2BackgroundBrush" Color="#FFF0EEFF" />
    <SolidColorBrush x:Key="LevelB2BorderBrush" Color="#FFD2CBFF" />

    <SolidColorBrush x:Key="TopicEverydayBackgroundBrush" Color="#FFF1F7FD" />
    <SolidColorBrush x:Key="TopicEverydayBorderBrush" Color="#FFBFD9F0" />
    <SolidColorBrush x:Key="TopicTravelBackgroundBrush" Color="#FFF0F8EF" />
    <SolidColorBrush x:Key="TopicTravelBorderBrush" Color="#FFC8E4BD" />
    <SolidColorBrush x:Key="TopicBusinessBackgroundBrush" Color="#FFF3F8FF" />
    <SolidColorBrush x:Key="TopicBusinessBorderBrush" Color="#FFC5D8F2" />
    <SolidColorBrush x:Key="TopicInterviewBackgroundBrush" Color="#FFEFF5FB" />
    <SolidColorBrush x:Key="TopicInterviewBorderBrush" Color="#FFAEC8E6" />
    <SolidColorBrush x:Key="TopicRestaurantBackgroundBrush" Color="#FFFFF4EA" />
    <SolidColorBrush x:Key="TopicRestaurantBorderBrush" Color="#FFF0C7A6" />
    <SolidColorBrush x:Key="TopicFreeConversationBackgroundBrush" Color="#FFF7F1FF" />
    <SolidColorBrush x:Key="TopicFreeConversationBorderBrush" Color="#FFD9C6F5" />
    <SolidColorBrush x:Key="SelectedTileBackgroundBrush" Color="#FFE8F2FF" />
    <SolidColorBrush x:Key="SelectedTileBorderBrush" Color="#FF2C7BE5" />

    <Style x:Key="SoftButtonBaseStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F4F8" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD6DEE8" />
                            <Setter Property="Foreground" Value="#FF8A98A8" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBaseStyle}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFF3F8FD" />
                <Setter Property="BorderBrush" Value="#FFB5CDE6" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFE6F0FA" />
                <Setter Property="BorderBrush" Value="#FF9CBFDF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LevelOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBaseStyle}">
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#FFF7FAFD" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="A1 Beginner">
                <Setter Property="Background" Value="{StaticResource LevelA1BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LevelA1BorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="A2 Elementary">
                <Setter Property="Background" Value="{StaticResource LevelA2BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LevelA2BorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="B1 Intermediate">
                <Setter Property="Background" Value="{StaticResource LevelB1BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LevelB1BorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="B2 Upper-Intermediate">
                <Setter Property="Background" Value="{StaticResource LevelB2BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LevelB2BorderBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{StaticResource SelectedTileBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopicTileButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBaseStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="#FFF7FAFD" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Id}" Value="1">
                <Setter Property="Background" Value="{StaticResource TopicEverydayBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicEverydayBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="2">
                <Setter Property="Background" Value="{StaticResource TopicTravelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicTravelBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="3">
                <Setter Property="Background" Value="{StaticResource TopicBusinessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicBusinessBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="4">
                <Setter Property="Background" Value="{StaticResource TopicInterviewBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicInterviewBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="5">
                <Setter Property="Background" Value="{StaticResource TopicRestaurantBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicRestaurantBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="6">
                <Setter Property="Background" Value="{StaticResource TopicFreeConversationBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicFreeConversationBorderBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtopicTileButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBaseStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="#FFF7FAFD" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TopicId}" Value="1">
                <Setter Property="Background" Value="{StaticResource TopicEverydayBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicEverydayBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TopicId}" Value="2">
                <Setter Property="Background" Value="{StaticResource TopicTravelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicTravelBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TopicId}" Value="3">
                <Setter Property="Background" Value="{StaticResource TopicBusinessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicBusinessBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TopicId}" Value="4">
                <Setter Property="Background" Value="{StaticResource TopicInterviewBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicInterviewBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TopicId}" Value="5">
                <Setter Property="Background" Value="{StaticResource TopicRestaurantBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicRestaurantBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TopicId}" Value="6">
                <Setter Property="Background" Value="{StaticResource TopicFreeConversationBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TopicFreeConversationBorderBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedTileBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SelectedTileBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MainContentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerLarge}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SoftTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FFB5CDE6" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FF2C7BE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder" Property="Background" Value="#FFF1F4F8" />
                            <Setter Property="Foreground" Value="#FF8A98A8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}" />
</ResourceDictionary>
