<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LessonChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:EnglishVoiceTutor.Desktop.Behaviors"
             xmlns:converters="clr-namespace:EnglishVoiceTutor.Desktop.Converters"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             xmlns:models="clr-namespace:EnglishVoiceTutor.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="SecondaryLessonButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <converters:AvatarAnimationUriConverter x:Key="AvatarAnimationUriConverter" />

            <LinearGradientBrush x:Key="NormalAvatarDimOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#990B1724" Offset="0" />
                <GradientStop Color="#1A0B1724" Offset="0.36" />
                <GradientStop Color="#330B1724" Offset="0.62" />
                <GradientStop Color="#B30B1724" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ConversationAvatarNoDimOverlayBrush" Color="#000B1724" />

            <Style x:Key="PrimaryLessonButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">
            <Border MaxWidth="1180"
                    Margin="0,12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource MainContentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" />
                            <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding BotStatusIndicatorBrush}" ToolTip="{Binding BotStatusText}" />
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding HistorySyncStatusIndicatorBrush}" ToolTip="{Binding HistorySyncStatusText}" />
                                <Ellipse Width="10" Height="10" Fill="{Binding AiStatusIndicatorBrush}" ToolTip="{Binding AiStatusText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Text="{Binding ContextText}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" Height="1" Background="{StaticResource BorderSoftBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,18,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="280" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                VerticalAlignment="Top"
                                Background="{StaticResource SurfaceSoftBrush}"
                                BorderBrush="{StaticResource FrameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerPanel}"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="MaxWidth" Value="{x:Static models:LessonChatLayoutOptions.NormalAvatarFrameMaxWidth}" />
                                    <Setter Property="MinHeight" Value="{x:Static models:LessonChatLayoutOptions.NormalAvatarFrameHeight}" />
                                    <Setter Property="Height" Value="{x:Static models:LessonChatLayoutOptions.NormalAvatarFrameHeight}" />
                                    <Setter Property="MaxHeight" Value="{x:Static models:LessonChatLayoutOptions.NormalAvatarFrameHeight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Setter Property="MaxWidth" Value="{x:Static models:LessonChatLayoutOptions.ConversationAvatarFrameMaxWidth}" />
                                            <Setter Property="MinHeight" Value="{x:Static models:LessonChatLayoutOptions.ConversationAvatarFrameHeight}" />
                                            <Setter Property="Height" Value="{x:Static models:LessonChatLayoutOptions.ConversationAvatarFrameHeight}" />
                                            <Setter Property="MaxHeight" Value="{x:Static models:LessonChatLayoutOptions.ConversationAvatarFrameHeight}" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       gif:AnimationBehavior.SourceUri="{Binding AvatarAnimationAssetUri, Converter={StaticResource AvatarAnimationUriConverter}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Stretch" Value="{x:Static models:LessonChatLayoutOptions.NormalAvatarStretchMode}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Stretch" Value="{x:Static models:LessonChatLayoutOptions.ConversationAvatarStretchMode}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Border IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource NormalAvatarDimOverlayBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ConversationAvatarNoDimOverlayBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>


                                <Button MinWidth="210"
                                        Margin="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Content="{Binding ConversationModeButtonText}"
                                        IsEnabled="{Binding IsLessonOptionsEnabled}"
                                        Command="{Binding ToggleConversationModeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryLessonButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Margin="32,0,32,28"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Bottom">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Padding="12,9"
                                                MaxWidth="520"
                                                Margin="0,0,0,8"
                                                Background="#DFFFFFFF"
                                                BorderBrush="#88CAD8E6"
                                                BorderThickness="1"
                                                CornerRadius="18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConversationLatestUserText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="You:"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           TextAlignment="Center" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding ConversationLatestUserText}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                MaxWidth="640"
                                                Background="#EEFFFFFF"
                                                BorderBrush="{StaticResource BorderAccentSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerPanel}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConversationLatestBotText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TutorAvatarDisplayName, StringFormat={}{0}:}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           TextAlignment="Center" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding ConversationLatestBotText}"
                                                           FontSize="15"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Button Width="70"
                                                Height="70"
                                                Margin="0,12,0,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding IsConversationRecordButtonEnabled}"
                                                Command="{Binding ToggleVoiceRecordingCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Width="70" Height="70">
                                                <Ellipse Fill="#FFFF3B30"
                                                         Stroke="#FFE02A20"
                                                         StrokeThickness="2">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Ellipse Fill="#22FF3B30" />
                                                <Border Width="32"
                                                        Height="32"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#FFFF3B30"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border MinWidth="220"
                                        MaxWidth="420"
                                        Margin="18,0,18,96"
                                        Padding="14,10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="#EAFBF7EF"
                                        BorderBrush="#99CAD8E6"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasConversationHintText}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Hint"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ConversationHintText}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button MinWidth="92"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="14,0,0,14"
                                        Padding="16,0"
                                        Background="#EFFFFFFF"
                                        BorderBrush="#99CAD8E6"
                                        BorderThickness="1"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Content="Hint"
                                        ToolTip="Show a short suggested answer"
                                        Cursor="Hand"
                                        Command="{Binding ConversationHintCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Width="42"
                                        Height="42"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,14,14"
                                        Padding="0"
                                        Background="#EFFFFFFF"
                                        BorderBrush="#99CAD8E6"
                                        BorderThickness="1"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Content="↩"
                                        ToolTip="{Binding BackToChatToolTip}"
                                        Cursor="Hand"
                                        IsEnabled="{Binding IsLessonOptionsEnabled}"
                                        Command="{Binding ToggleConversationModeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                MinHeight="500"
                                MaxHeight="680"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource FrameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerPanel}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SoftPanelStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Margin="0,0,0,14"
                                        Padding="12"
                                        Background="{StaticResource SurfaceSoftBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerPanel}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  behaviors:ScrollViewerMouseWheelBehavior.BubbleMouseWheelWhenAtEdge="True"
                                                  behaviors:ScrollViewerAutoScrollBehavior.AutoScrollToBottom="True">
                                        <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ChatMessageBubbleStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBox Margin="0,4,0,0" Text="{Binding Text, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />

                                                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                            <Button Padding="8,2"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding TranslateButtonText}"
                                                                    Command="{Binding ToggleTranslationCommand}"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    FontSize="11"
                                                                    BorderBrush="{StaticResource BorderAccentSoftBrush}"
                                                                    Cursor="Hand" />

                                                            <Button Margin="8,0,0,0"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding DataContext.PlayVoiceButtonText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Command="{Binding DataContext.PlayBotVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    FontSize="11"
                                                                    BorderBrush="{StaticResource BorderAccentSoftBrush}"
                                                                    Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowPlayVoiceButton}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <Button Margin="8,0,0,0"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding DataContext.ViewFeedbackButtonText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Command="{Binding DataContext.ViewFeedbackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    FontSize="11"
                                                                    BorderBrush="{StaticResource BorderAccentSoftBrush}"
                                                                    Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanShowFeedbackAction}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </WrapPanel>

                                                        <Border Margin="0,8,0,0" Padding="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTranslationVisible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DataContext.TranslationLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                                                <TextBox Margin="0,4,0,0" Text="{Binding TranslationText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                            </StackPanel>
                                                        </Border>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border x:Name="FeedbackPanelCard"
                                        Margin="0,10,0,12"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonUp="FeedbackPanelCard_PreviewMouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource LessonSupportPanelStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedFeedbackPanel}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FeedbackPanelTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                    <Button Margin="8,0,0,0"
                                                            Padding="6,1"
                                                            Content="{Binding ClickToCloseText}"
                                                            Command="{Binding CloseFeedbackCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            FontSize="11"
                                                            Cursor="Hand" />
                                                </StackPanel>

                                                <StackPanel Margin="0,10,0,0">
                                                    <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderAccentSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                        <StackPanel>
                                                            <TextBlock Text="Feedback for" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedbackSourceText, Mode=OneWay}" ToolTip="{Binding SelectedFeedbackSourceText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedFeedbackLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Loading feedback..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedFeedback}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button Margin="0,0,0,8"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding FeedbackTranslateButtonText}"
                                                        Command="{Binding ToggleFeedbackTranslationCommand}"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        FontSize="11"
                                                        BorderBrush="{StaticResource BorderAccentSoftBrush}"
                                                        Cursor="Hand" />

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasShortText}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="Quick summary" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.ShortText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.ShortTextTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasCorrectedVersion}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FeedbackCorrectedVersionTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.CorrectedVersion, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.CorrectedVersionTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasGrammarTip}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FeedbackGrammarTipTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.GrammarTip, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.GrammarTipTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasVocabularyTip}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FeedbackVocabularyTipTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.VocabularyTip, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.VocabularyTipTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasCultureTip}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FeedbackCultureTipTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.CultureTip, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.CultureTipTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerSmall}">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFeedback.HasNaturalVersion}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FeedbackNaturalVersionTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.NaturalVersion, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SelectableChatTextBoxStyle}" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedFeedback.NaturalVersionTranslation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableChatTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource LessonSupportPanelStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCurrentHint}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Command="{Binding CloseHintCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding HintPanelTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Margin="8,2,0,0" Text="{Binding ClickToCloseText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Margin="0,8,0,0" Text="{Binding CurrentHintText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Grid.Row="1">
                                    <TextBox x:Name="LessonInputTextBox"
                                             MinHeight="42"
                                             Margin="0,0,0,12"
                                             VerticalContentAlignment="Center"
                                             AcceptsReturn="False"
                                             IsEnabled="{Binding CanTypeText}"
                                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{Binding SendButtonText}" Command="{Binding SendMessageCommand}" Margin="0,0,8,0" MinWidth="96" Style="{StaticResource PrimaryLessonButtonStyle}" />
                                            <Button Content="{Binding VoiceButtonText}" Command="{Binding ToggleVoiceRecordingCommand}" Margin="0,0,8,0" MinWidth="170" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                            <Button Content="{Binding HintButtonText}" Command="{Binding HintCommand}" MinWidth="96" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <CheckBox Margin="0,0,18,0"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Content="{Binding AutoSendVoiceLabel}"
                                                      IsChecked="{Binding IsVoiceAutoSendEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLessonOptionsEnabled}"
                                                      ToolTip="{Binding AutoSendVoiceToolTip}" />
                                            <CheckBox VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Content="{Binding AutoPlayBotVoiceLabel}"
                                                      IsChecked="{Binding IsBotVoiceAutoPlayEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLessonOptionsEnabled}"
                                                      ToolTip="{Binding AutoPlayBotVoiceToolTip}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{Binding FinishLessonButtonText}" Command="{Binding FinishLessonCommand}" Margin="0,0,8,0" MinWidth="150" Style="{StaticResource PrimaryLessonButtonStyle}" />
                                            <Button Content="{Binding BackButtonText}" Command="{Binding BackCommand}" MinWidth="96" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
