<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LessonChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:EnglishVoiceTutor.Desktop.Behaviors"
             xmlns:converters="clr-namespace:EnglishVoiceTutor.Desktop.Converters"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="#FFF6F8FB">
        <Grid.Resources>
            <Style x:Key="SecondaryLessonButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#FF1E3A56" />
                <Setter Property="BorderBrush" Value="#FFCAD8E6" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <converters:AvatarAnimationUriConverter x:Key="AvatarAnimationUriConverter" />

            <Style x:Key="PrimaryLessonButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="#FF1E3A56" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#FF1E3A56" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">
            <Border MaxWidth="1180"
                    Margin="0,12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#FFE1E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="#FF1C2B3A" TextAlignment="Center" />
                            <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding BotStatusIndicatorBrush}" ToolTip="{Binding BotStatusText}" />
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding BackendStatusIndicatorBrush}" ToolTip="{Binding BackendStatusText}" />
                                <Ellipse Width="10" Height="10" Fill="{Binding AiStatusIndicatorBrush}" ToolTip="{Binding AiStatusText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Text="{Binding ContextText}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" Height="1" Background="#FFE1E8F0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,18,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="280" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                VerticalAlignment="Stretch"
                                Background="#FF0F1F2E"
                                BorderBrush="#FFDCE8F5"
                                BorderThickness="1"
                                CornerRadius="18"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="MaxWidth" Value="360" />
                                    <Setter Property="MinHeight" Value="500" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Setter Property="MaxWidth" Value="760" />
                                            <Setter Property="MinHeight" Value="660" />
                                            <Setter Property="Height" Value="660" />
                                            <Setter Property="MaxHeight" Value="660" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ToolTip="{Binding AvatarAnimationAssetPath}">
                                <Image HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       gif:AnimationBehavior.SourceUri="{Binding AvatarAnimationAssetUri, Converter={StaticResource AvatarAnimationUriConverter}}" />

                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#990B1724" Offset="0" />
                                            <GradientStop Color="#1A0B1724" Offset="0.36" />
                                            <GradientStop Color="#330B1724" Offset="0.62" />
                                            <GradientStop Color="#B30B1724" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>


                                <Button Width="190"
                                        Margin="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Content="{Binding ConversationModeButtonText}"
                                        IsEnabled="{Binding IsLessonOptionsEnabled}"
                                        Command="{Binding ToggleConversationModeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryLessonButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Margin="32,0,32,28"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Bottom">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Padding="14"
                                                MaxWidth="640"
                                                Background="#DFFFFFFF"
                                                BorderBrush="#80FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LatestBotMessageText}"
                                                           FontSize="15"
                                                           Foreground="#FF1C2B3A"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Button Width="70"
                                                Height="70"
                                                Margin="0,12,0,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding IsLessonInputEnabled}"
                                                Command="{Binding ToggleVoiceRecordingCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Width="70" Height="70">
                                                <Ellipse Fill="#FFFF3B30"
                                                         Stroke="#FFE02A20"
                                                         StrokeThickness="2">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Ellipse Fill="#22FF3B30" />
                                                <Border Width="32"
                                                        Height="32"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#FFFF3B30"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Button Width="42"
                                        Height="42"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,14,14"
                                        Padding="0"
                                        Background="#EFFFFFFF"
                                        BorderBrush="#99CAD8E6"
                                        BorderThickness="1"
                                        Foreground="#FF1E3A56"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Content="↩"
                                        ToolTip="{Binding BackToChatToolTip}"
                                        Cursor="Hand"
                                        IsEnabled="{Binding IsLessonOptionsEnabled}"
                                        Command="{Binding ToggleConversationModeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="24"
                                Background="White"
                                CornerRadius="16"
                                BorderBrush="#FFE1E8F0"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationModeEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0"
                                              MaxHeight="300"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              behaviors:ScrollViewerMouseWheelBehavior.BubbleMouseWheelWhenAtEdge="True"
                                              behaviors:ScrollViewerAutoScrollBehavior.AutoScrollToBottom="True">
                                    <ItemsControl ItemsSource="{Binding Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="10" HorizontalAlignment="Left" MaxWidth="620" Background="#FFF2F7FC">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Setter Property="Background" Value="#FFF2F7FC" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                                    <Setter Property="Background" Value="#FFEAF6EA" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding Text}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />

                                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                            <Button Padding="8,2"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding TranslateButtonText}"
                                                                    Command="{Binding ToggleTranslationCommand}"
                                                                    Background="White"
                                                                    Foreground="#FF506172"
                                                                    FontSize="11"
                                                                    BorderBrush="#FFD4DEE8"
                                                                    Cursor="Hand" />

                                                            <Button Margin="8,0,0,0"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding DataContext.PlayVoiceButtonText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Command="{Binding DataContext.PlayBotVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="White"
                                                                    Foreground="#FF506172"
                                                                    FontSize="11"
                                                                    BorderBrush="#FFD4DEE8"
                                                                    Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowPlayVoiceButton}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <Button Margin="8,0,0,0"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Left"
                                                                    Content="{Binding DataContext.ViewFeedbackButtonText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Command="{Binding DataContext.ViewFeedbackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="White"
                                                                    Foreground="#FF506172"
                                                                    FontSize="11"
                                                                    BorderBrush="#FFD4DEE8"
                                                                    Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>

                                                        <Border Margin="0,8,0,0" Padding="8" Background="White" BorderBrush="#FFE1E8F0" BorderThickness="1" CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTranslationVisible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DataContext.TranslationLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="11" FontWeight="SemiBold" Foreground="#FF6D7C8B" />
                                                                <TextBlock Margin="0,4,0,0" Text="{Binding TranslationText}" FontSize="13" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCurrentHint}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Button Command="{Binding CloseHintCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Padding="14" Background="#FFEFF7FF" BorderBrush="#FFB9D9F5" BorderThickness="1" CornerRadius="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding HintPanelTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                                    <TextBlock Margin="8,2,0,0" Text="{Binding ClickToCloseText}" FontSize="11" Foreground="#FF6D7C8B" />
                                                </StackPanel>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding CurrentHintText}" FontSize="13" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedFeedback}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Button Command="{Binding CloseFeedbackCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Padding="14" Background="#FFFFF9E8" BorderBrush="#FFF0D58A" BorderThickness="1" CornerRadius="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FeedbackPanelTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                                    <TextBlock Margin="8,2,0,0" Text="{Binding ClickToCloseText}" FontSize="11" Foreground="#FF7A8A9A" />
                                                </StackPanel>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedFeedback.ShortText}" FontSize="13" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedFeedback.ShortTextTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Margin="0,10,0,10"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding FeedbackTranslateButtonText}"
                                                        Command="{Binding ToggleFeedbackTranslationCommand}"
                                                        Background="White"
                                                        Foreground="#FF506172"
                                                        FontSize="11"
                                                        BorderBrush="#FFD4DEE8"
                                                        Cursor="Hand" />

                                                <TextBlock Text="{Binding FeedbackCorrectedVersionTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.CorrectedVersion}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.CorrectedVersionTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding FeedbackGrammarTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.GrammarTip}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.GrammarTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding FeedbackVocabularyTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.VocabularyTip}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.VocabularyTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding FeedbackCultureTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.CultureTip}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.CultureTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding FeedbackNaturalVersionTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.NaturalVersion}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.NaturalVersionTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#FF7A8A9A" TextWrapping="Wrap">
                                                    <Run Text="{Binding FeedbackTranslationHeader, Mode=OneWay}" />
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <TextBox Height="42"
                                             Margin="0,0,0,12"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IsLessonInputEnabled}"
                                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{Binding SendButtonText}" Command="{Binding SendMessageCommand}" Margin="0,0,8,0" Width="90" Style="{StaticResource PrimaryLessonButtonStyle}" />
                                            <Button Content="{Binding VoiceButtonText}" Command="{Binding ToggleVoiceRecordingCommand}" Margin="0,0,8,0" Width="150" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                            <Button Content="{Binding HintButtonText}" Command="{Binding HintCommand}" Width="90" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <CheckBox Margin="0,0,18,0"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Content="{Binding AutoSendVoiceLabel}"
                                                      IsChecked="{Binding IsVoiceAutoSendEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLessonOptionsEnabled}"
                                                      ToolTip="{Binding AutoSendVoiceToolTip}" />
                                            <CheckBox VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Content="{Binding AutoPlayBotVoiceLabel}"
                                                      IsChecked="{Binding IsBotVoiceAutoPlayEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLessonOptionsEnabled}"
                                                      ToolTip="{Binding AutoPlayBotVoiceToolTip}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{Binding FinishLessonButtonText}" Command="{Binding FinishLessonCommand}" Margin="0,0,8,0" Width="110" Style="{StaticResource PrimaryLessonButtonStyle}" />
                                            <Button Content="{Binding BackButtonText}" Command="{Binding BackCommand}" Width="90" Style="{StaticResource SecondaryLessonButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}" FontSize="13" Foreground="#FF3A4A5B" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
