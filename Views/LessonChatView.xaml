<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LessonChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:constants="clr-namespace:EnglishVoiceTutor.Desktop.Constants"
             xmlns:behaviors="clr-namespace:EnglishVoiceTutor.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="#FFF6F8FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">
            <Border MaxWidth="820"
                    Margin="0,12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#FFE1E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="#FF1C2B3A" TextAlignment="Center" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding ContextText}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding BotStatusText}" FontSize="13" Foreground="#FF1E3A56" TextAlignment="Center" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BackendStatusText}" FontSize="12" Foreground="#FF6D7C8B" TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" Height="1" Background="#FFE1E8F0" />

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,16,0,12"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:ScrollViewerMouseWheelBehavior.BubbleMouseWheelWhenAtEdge="True">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="10" HorizontalAlignment="Left" MaxWidth="620" Background="#FFF2F7FC">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Background" Value="#FFF2F7FC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="Background" Value="#FFEAF6EA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Text}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />

                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <Button Padding="8,2"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding TranslateButtonText}"
                                                        Command="{Binding ToggleTranslationCommand}"
                                                        Background="White"
                                                        Foreground="#FF506172"
                                                        FontSize="11"
                                                        BorderBrush="#FFD4DEE8"
                                                        Cursor="Hand" />

                                                <Button Margin="8,0,0,0"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left"
                                                        Content="{x:Static constants:AppConstants.ViewFeedbackButtonText}"
                                                        Command="{Binding DataContext.ViewFeedbackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="White"
                                                        Foreground="#FF1E3A56"
                                                        BorderBrush="#FFCAD8E6"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <Border Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="#33A0AFBF" BorderThickness="0,1,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTranslationVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TranslationHeader}" FontSize="11" Foreground="#FF6D7C8B" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding TranslationText}" FontSize="12" Foreground="#FF637381" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedFeedback}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Padding="10,4"
                                HorizontalAlignment="Left"
                                FontSize="11"
                                Content="{Binding FeedbackTranslateButtonText}"
                                Command="{Binding ToggleFeedbackTranslationCommand}"
                                Background="White"
                                Foreground="#FF506172"
                                BorderBrush="#FFD4DEE8"
                                Cursor="Hand" />

                        <Button Margin="0,8,0,0"
                                Padding="12"
                                Command="{Binding CloseFeedbackCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Border Padding="12"
                                    Background="#FFF7FAFD"
                                    BorderBrush="#FFDDE8F3"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackPanelTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#FF1C2B3A" />
                                    <TextBlock Margin="0,2,0,8" Text="Click this feedback card to close." FontSize="11" Foreground="#FF7A8A9A" />

                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedFeedback.ShortText}" FontSize="13" Foreground="#FF3A4A5B" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,8" Text="{Binding SelectedFeedback.ShortTextTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackCorrectedVersionTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.CorrectedVersion}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.CorrectedVersionTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackGrammarTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.GrammarTip}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.GrammarTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackVocabularyTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.VocabularyTip}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.VocabularyTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackCultureTipTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.CultureTip}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,6" Text="{Binding SelectedFeedback.CultureTipTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{x:Static constants:AppConstants.FeedbackNaturalVersionTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E3A56" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.NaturalVersion}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedFeedback.NaturalVersionTranslation}" FontSize="12" Foreground="#FF6D7C8B" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#FF7A8A9A" TextWrapping="Wrap">
                                        <Run Text="{Binding FeedbackTranslationHeader, Mode=OneWay}" />
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFeedbackTranslationVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBox Height="42"
                                 Margin="0,0,0,12"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" />

                        <WrapPanel HorizontalAlignment="Center" ItemHeight="38">
                            <Button Content="Send" Command="{Binding SendMessageCommand}" Margin="0,0,8,8" Width="90" Height="38" Background="#FF1E3A56" Foreground="White" BorderBrush="#FF1E3A56" Cursor="Hand" />
                            <Button Content="Hint" Command="{Binding HintCommand}" Margin="0,0,8,8" Width="90" Height="38" Background="White" Foreground="#FF1E3A56" BorderBrush="#FFCAD8E6" Cursor="Hand" />
                            <Button Content="Voice later" IsEnabled="False" Margin="0,0,8,8" Width="110" Height="38" Background="#FFF3F3F3" Foreground="#FF7A7A7A" BorderBrush="#FFD8D8D8" />
                            <Button Content="Finish lesson" Command="{Binding FinishLessonCommand}" Margin="0,0,8,8" Width="110" Height="38" Background="#FF1E3A56" Foreground="White" BorderBrush="#FF1E3A56" Cursor="Hand" />
                            <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,0,8" Width="90" Height="38" Background="White" Foreground="#FF1E3A56" BorderBrush="#FFCAD8E6" Cursor="Hand" />
                        </WrapPanel>

                        <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}" FontSize="13" Foreground="#FF3A4A5B" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
