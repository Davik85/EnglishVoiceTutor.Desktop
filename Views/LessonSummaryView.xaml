<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LessonSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="820"
                Margin="0,12"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource CornerLarge}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="#FF1C2B3A" TextAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding ContextText}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />

                    <Border Margin="0,20,0,0" Padding="16" Background="#FFF7FBFF" CornerRadius="{StaticResource CornerMedium}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding GoodTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding GoodText}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="16" Background="#FFFFFAF3" CornerRadius="{StaticResource CornerMedium}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ImproveTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding ImproveText}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="16" Background="#FFF7FBFF" CornerRadius="{StaticResource CornerMedium}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding UsefulPhrasesTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding UsefulPhrases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding StringFormat=• {0}}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Content="{Binding TranslationButtonText}"
                                Command="{Binding ToggleSummaryTranslationCommand}"
                                MinWidth="140"
                                Height="34"
                                Padding="18,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding TranslationStatusText}" FontSize="13" Foreground="#FF526B84" TextAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding TranslationErrorText}" FontSize="13" Foreground="#FFC2410C" TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTranslationError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Margin="0,14,0,0" Padding="16" Background="#FFF0FDF4" CornerRadius="{StaticResource CornerMedium}" BorderBrush="#FFBDE7C7" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTranslatedSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding TranslationLabel}" FontSize="18" FontWeight="SemiBold" Foreground="#FF166534" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding TranslatedSummaryText}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding ChooseAnotherSituationText}"
                                Command="{Binding ChooseAnotherSituationCommand}"
                                Margin="0,0,10,0"
                                MinWidth="200"
                                Height="38"
                                Padding="18,0"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="{Binding BackToTopicsText}"
                                Command="{Binding BackToTopicsCommand}"
                                MinWidth="140"
                                Height="38"
                                Padding="18,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
