<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LessonHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="820"
                Margin="0,12"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource CornerLarge}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Foreground="#FF1C2B3A" TextAlignment="Center" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Subtitle, Mode=OneWay}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock Margin="0,24,0,0" Text="{Binding EmptyHistoryText, Mode=OneWay}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory, Mode=OneWay}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Items, Mode=OneWay}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory, Mode=OneWay}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="16" Background="#FFF7FBFF" CornerRadius="{StaticResource CornerMedium}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CompletedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="12" Foreground="#FF587189" />
                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#FF1E3A56">
                                                <Run Text="{Binding DataContext.TopicLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding TopicTitle, Mode=OneWay}" />
                                                <Run Text=" • " />
                                                <Run Text="{Binding DataContext.SituationLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding SubtopicTitle, Mode=OneWay}" />
                                                <Run Text=" • " />
                                                <Run Text="{Binding DataContext.LevelLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding SelectedLevel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,10,0,0" Text="{Binding DataContext.GoodLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding GoodText, Mode=OneWay}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />

                                            <TextBlock Margin="0,10,0,0" Text="{Binding DataContext.ImproveLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding ImproveText, Mode=OneWay}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" />

                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding UsefulPhrases, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Mode=OneWay, StringFormat=• {0}}" FontSize="14" Foreground="#FF1C2B3A" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1"
                        Content="{Binding BackButtonText, Mode=OneWay}"
                        Command="{Binding BackCommand}"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        MinWidth="160"
                        Height="38"
                        Padding="18,0"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
