<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <sys:Double x:Key="SettingsNavigationWidth">176</sys:Double>
        <sys:Double x:Key="SettingsDropdownWidth">276</sys:Double>
        <sys:Double x:Key="SettingsTextInputWidth">340</sys:Double>
        <sys:Double x:Key="SettingsMicrophoneDropdownWidth">440</sys:Double>
        <sys:Double x:Key="SettingsBackendUrlInputWidth">480</sys:Double>
        <sys:Double x:Key="SettingsControlHeight">42</sys:Double>
        <Thickness x:Key="SettingsPagePadding">28,24,28,22</Thickness>
        <Thickness x:Key="SettingsSectionGap">0,16,0,0</Thickness>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="SettingsSectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
            <Setter Property="Width" Value="{StaticResource SettingsTextInputWidth}" />
            <Setter Property="Height" Value="{StaticResource SettingsControlHeight}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SettingsBackendUrlTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
            <Setter Property="Width" Value="{StaticResource SettingsBackendUrlInputWidth}" />
        </Style>

        <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Width" Value="{StaticResource SettingsTextInputWidth}" />
            <Setter Property="Height" Value="{StaticResource SettingsControlHeight}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerTextInput}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBoxBorder" Property="BorderBrush" Value="{StaticResource FocusBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBoxBorder" Property="BorderBrush" Value="{StaticResource FocusBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBoxBorder" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="{StaticResource SettingsDropdownWidth}" />
            <Setter Property="Height" Value="{StaticResource SettingsControlHeight}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsMicrophoneComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="Width" Value="{StaticResource SettingsMicrophoneDropdownWidth}" />
        </Style>

        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsSectionNavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="{StaticResource SettingsNavigationWidth}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationItemBorder"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{StaticResource BorderAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationItemBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="Margin" Value="18,0,0,0" />
        </Style>

        <Style x:Key="SettingsSectionStackStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="StatisticsValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="AvatarProfileLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="AvatarProfileValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DiagnosticsLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DiagnosticsValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource SettingsPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Title}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,18" Height="1" Background="{StaticResource BorderSoftBrush}" />

            <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Width="{StaticResource SettingsNavigationWidth}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <RadioButton x:Name="LearningSectionNav"
                                 Content="{Binding LearningTabHeader, ElementName=Root}"
                                 GroupName="SettingsSections"
                                 IsChecked="True"
                                 Style="{StaticResource SettingsSectionNavigationButtonStyle}" />
                    <RadioButton x:Name="AccountSectionNav"
                                 Content="{Binding AccountTabHeader, ElementName=Root}"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource SettingsSectionNavigationButtonStyle}" />
                    <RadioButton x:Name="AudioSectionNav"
                                 Content="{Binding AudioTabHeader, ElementName=Root}"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource SettingsSectionNavigationButtonStyle}" />
                    <RadioButton x:Name="ProgressSectionNav"
                                 Content="{Binding ProgressTabHeader, ElementName=Root}"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource SettingsSectionNavigationButtonStyle}" />
                    <RadioButton x:Name="DiagnosticsSectionNav"
                                 Content="{Binding DiagnosticsTabHeader, ElementName=Root}"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource SettingsSectionNavigationButtonStyle}"
                                 Visibility="{Binding IsDiagnosticsTabVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <ScrollViewer x:Name="LearningSection" Grid.Column="1" Style="{StaticResource SettingsSectionScrollViewerStyle}" Visibility="{Binding IsChecked, ElementName=LearningSectionNav, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource SettingsSectionStackStyle}">
                            <Border Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding UserProfileTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding UserProfileSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <TextBlock Text="{Binding UserDisplayNameLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="{Binding LearningGoalLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding LearningGoal, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StudyLanguageTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding StudyLanguageSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                              ItemsSource="{Binding AvailableStudyLanguages}"
                                              SelectedItem="{Binding SelectedStudyLanguage, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NativeLanguageTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding NativeLanguageSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                              ItemsSource="{Binding AvailableNativeLanguages}"
                                              SelectedItem="{Binding SelectedNativeLanguageOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding InterfaceLanguageTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />

                                    <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                              ItemsSource="{Binding AvailableInterfaceLanguages}"
                                              SelectedItem="{Binding SelectedInterfaceLanguageOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TutorAvatarTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding TutorAvatarSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                              ItemsSource="{Binding AvailableTutorAvatars}"
                                              SelectedItem="{Binding SelectedTutorAvatarOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AvatarProfileTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,2,0,10"
                                               Text="{Binding SelectedTutorAvatarDisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Padding="12"
                                            Background="{StaticResource AppBackgroundBrush}"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AvatarAgeLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTutorAvatarAgeText}" Style="{StaticResource AvatarProfileValueStyle}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AvatarLocationLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTutorAvatarLocation}" Style="{StaticResource AvatarProfileValueStyle}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AvatarRoleLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTutorAvatarRole}" Style="{StaticResource AvatarProfileValueStyle}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AvatarInterestsLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTutorAvatarInterestsText}" Style="{StaticResource AvatarProfileValueStyle}" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AvatarPersonalityLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTutorAvatarPersonalityText}" Style="{StaticResource AvatarProfileValueStyle}" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding AvatarSpeakingStyleLabel, StringFormat={}{0}:}" Style="{StaticResource AvatarProfileLabelStyle}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTutorAvatarSpeakingStyleText}" Style="{StaticResource AvatarProfileValueStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AccountSection" Grid.Column="1" Style="{StaticResource SettingsSectionScrollViewerStyle}" Visibility="{Binding IsChecked, ElementName=AccountSectionNav, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource SettingsSectionStackStyle}">
                            <Border Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AccountTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding AccountSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <TextBlock Text="{Binding CurrentAccountLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding CurrentUserEmail, TargetNullValue=Not signed in}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding CurrentUserDisplayName}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <TextBlock Text="{Binding SettingsSourceLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding SettingsSource}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding SubscriptionStatusTitle}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding SubscriptionPlanText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionPremiumText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionTrialText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionFreeLessonText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionEnforcementText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionSourceText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SubscriptionCheckedAtText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding AccountEmailLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="{Binding AccountPasswordLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <PasswordBox x:Name="AccountPasswordBox"
                                                 Style="{StaticResource SettingsPasswordBoxStyle}"
                                                 PasswordChanged="AccountPasswordBox_OnPasswordChanged" />

                                    <TextBlock Text="{Binding AccountDisplayNameLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding RegistrationDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button MinWidth="100"
                                                MinHeight="40"
                                                Margin="0,0,8,8"
                                                Content="{Binding AccountRegisterButtonText}"
                                                Foreground="White"
                                                Command="{Binding RegisterCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button MinWidth="100"
                                                MinHeight="40"
                                                Margin="0,0,8,8"
                                                Content="{Binding AccountLoginButtonText}"
                                                Foreground="White"
                                                Command="{Binding LoginCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button MinWidth="100"
                                                MinHeight="40"
                                                Margin="0,0,0,8"
                                                Content="{Binding AccountLogoutButtonText}"
                                                Foreground="{StaticResource AccentBrush}"
                                                Command="{Binding LogoutCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding ErrorMessage}"
                                               FontSize="12"
                                               Foreground="#FFB00020"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AudioSection" Grid.Column="1" Style="{StaticResource SettingsSectionScrollViewerStyle}" Visibility="{Binding IsChecked, ElementName=AudioSectionNav, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource SettingsSectionStackStyle}">
                            <Border Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AudioInputTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />

                                    <TextBlock Text="{Binding MicrophoneLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <ComboBox Style="{StaticResource SettingsMicrophoneComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                              ItemsSource="{Binding AudioInputDevices}"
                                              SelectedItem="{Binding SelectedAudioInputDeviceOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayName" />

                                    <Button MinWidth="150"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"
                                            Content="{Binding TestMicrophoneText}"
                                            Command="{Binding TestMicrophoneCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding MicrophoneStatusText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProgressSection" Grid.Column="1" Style="{StaticResource SettingsSectionScrollViewerStyle}" Visibility="{Binding IsChecked, ElementName=ProgressSectionNav, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource SettingsSectionStackStyle}">
                            <Border Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LearningStatisticsTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding LearningStatisticsSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <UniformGrid Margin="0,14,0,0" Columns="2">
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="{Binding TotalCompletedLessonsLabel}" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0" />
                                            <TextBlock Text="{Binding TotalCompletedLessonsText}" Style="{StaticResource StatisticsValueStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding LessonsTodayLabel}" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0" />
                                            <TextBlock Text="{Binding LessonsTodayText}" Style="{StaticResource StatisticsValueStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CurrentStreakLabel}" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0" />
                                            <TextBlock Text="{Binding CurrentStreakText}" Style="{StaticResource StatisticsValueStyle}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LastCompletedLessonLabel}" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0" />
                                            <TextBlock Text="{Binding LastCompletedLessonText}" Style="{StaticResource StatisticsValueStyle}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DiagnosticsSection" Grid.Column="1">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionScrollViewerStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=DiagnosticsSectionNav}" Value="True" />
                                        <Condition Binding="{Binding IsDiagnosticsTabVisible, ElementName=Root}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                        <StackPanel Style="{StaticResource SettingsSectionStackStyle}">
                            <Border Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding BackendUrlSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <TextBlock Text="{Binding BackendUrlLabel}" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsBackendUrlTextBoxStyle}"
                                             Text="{Binding BackendBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource SettingsSectionGap}" Style="{StaticResource SettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DiagnosticsTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{Binding DiagnosticsSubtitle}" Style="{StaticResource SettingsSectionSubtitleStyle}" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DiagnosticsAppVersionLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersionText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DiagnosticsBackendUrlLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticsBackendUrlText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DiagnosticsBackendStatusLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiagnosticsBackendStatusText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DiagnosticsDatabaseStatusLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticsDatabaseStatusText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding DiagnosticsAiStatusLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiagnosticsAiStatusText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding DiagnosticsSettingsFileLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SettingsFilePathText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding DiagnosticsLessonHistoryFileLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LessonHistoryFilePathText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding DiagnosticsInterfaceLanguageLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DiagnosticsInterfaceLanguageText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding DiagnosticsNativeLanguageLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DiagnosticsNativeLanguageText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding DiagnosticsStudyLanguageLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DiagnosticsStudyLanguageText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding DiagnosticsTutorAvatarLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding DiagnosticsTutorAvatarText}" Style="{StaticResource DiagnosticsValueStyle}" />

                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{Binding DiagnosticsMicrophoneLabel, StringFormat={}{0}:}" Style="{StaticResource DiagnosticsLabelStyle}" />
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding DiagnosticsMicrophoneText}" Style="{StaticResource DiagnosticsValueStyle}" />
                                    </Grid>

                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Button MinWidth="150"
                                                Height="34"
                                                Content="{Binding RefreshDiagnosticsButtonText}"
                                                Command="{Binding RefreshDiagnosticsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button MinWidth="150"
                                                Height="34"
                                                Margin="10,0,0,0"
                                                Content="{Binding CopyDiagnosticsText}"
                                                Command="{Binding CopyDiagnosticsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding DiagnosticsCopyStatusText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </ScrollViewer>

            </Grid>

            <Border Grid.Row="3"
                    Margin="0,18,0,0"
                    Padding="0,14,0,0"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemHeight="38">
                        <Button Width="100"
                                Height="38"
                                Margin="0,0,8,0"
                                Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Width="100"
                                Height="38"
                                Content="{Binding BackButtonText}"
                                Command="{Binding BackCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
