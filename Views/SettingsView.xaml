<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="#FFF6F8FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">
            <Border MaxWidth="620"
                    Margin="0,20"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#FFE1E8F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="#FF1C2B3A" TextAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding Subtitle}" FontSize="14" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />

                    <Border Margin="0,20,0,0" Height="1" Background="#FFE1E8F0" />

                    <TextBlock Margin="0,20,0,0" Text="{Binding NativeLanguageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding NativeLanguageSubtitle}" FontSize="13" Foreground="#FF5B6B7B" TextWrapping="Wrap" />

                    <ComboBox Margin="0,12,0,0"
                              Height="38"
                              ItemsSource="{Binding SupportedNativeLanguages}"
                              SelectedItem="{Binding SelectedNativeLanguage, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Margin="0,20,0,0" Height="1" Background="#FFE1E8F0" />

                    <TextBlock Margin="0,20,0,0" Text="{Binding TutorAvatarTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#FF1E3A56" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding TutorAvatarSubtitle}" FontSize="13" Foreground="#FF5B6B7B" TextWrapping="Wrap" />

                    <ComboBox Margin="0,12,0,0"
                              Height="38"
                              ItemsSource="{Binding AvailableTutorAvatars}"
                              SelectedItem="{Binding SelectedTutorAvatarOption, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SelectedTutorAvatarDescription}"
                               FontSize="13"
                               Foreground="#FF5B6B7B"
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center" ItemHeight="38">
                        <Button Width="100"
                                Height="38"
                                Margin="0,0,8,0"
                                Content="Save"
                                Command="{Binding SaveCommand}"
                                Background="#FF1E3A56"
                                Foreground="White"
                                BorderBrush="#FF1E3A56"
                                Cursor="Hand" />
                        <Button Width="100"
                                Height="38"
                                Content="Back"
                                Command="{Binding BackCommand}"
                                Background="White"
                                Foreground="#FF1E3A56"
                                BorderBrush="#FFCAD8E6"
                                Cursor="Hand" />
                    </WrapPanel>

                    <TextBlock Margin="0,14,0,0" Text="{Binding StatusMessage}" FontSize="13" Foreground="#FF3A4A5B" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
