<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="24" Background="#FFF6F8FB">
        <Border MaxWidth="720"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16"
                BorderBrush="#FFE1E8F0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding AppTitle}"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="#FF1C2B3A"
                           TextAlignment="Center" />

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="18"
                           Foreground="#FF3A4A5B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Border Margin="0,28,0,0"
                        Padding="20"
                        Background="#FFF8FAFD"
                        BorderBrush="#FFD9E3EE"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="How the MVP works"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1C2B3A" />
                        <TextBlock Margin="0,14,0,0"
                                   Text="• Choose a topic"
                                   FontSize="16"
                                   Foreground="#FF2E4053" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="• Practice by text or voice"
                                   FontSize="16"
                                   Foreground="#FF2E4053" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="• Get soft corrections and hints"
                                   FontSize="16"
                                   Foreground="#FF2E4053" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,30,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="Start lesson"
                            Command="{Binding StartLessonCommand}"
                            Width="170"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#FF2C7BE5"
                            Foreground="White"
                            BorderBrush="#FF2C7BE5"
                            Cursor="Hand" />
                    <Button Content="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            Width="140"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#FFEAF0F8"
                            Foreground="#FF1E3A56"
                            BorderBrush="#FFCAD8E6"
                            Cursor="Hand" />
                </StackPanel>

                <TextBlock Margin="0,16,0,0"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="#FF3A4A5B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,24,0,0"
                           Text="{Binding FooterNote}"
                           FontSize="13"
                           Foreground="#FF66788A"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
