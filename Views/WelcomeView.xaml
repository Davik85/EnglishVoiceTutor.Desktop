<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="760">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border Width="540"
                Height="640"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderAccentSoftBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerContainer}"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="12"
                                  Color="#FF173B57" />
            </Border.Effect>

            <Grid>
                <Image Source="/Assets/Welcome/welcome-cover.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       SnapsToDevicePixels="True" />

                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3F061726" Offset="0" />
                            <GradientStop Color="#10061726" Offset="0.42" />
                            <GradientStop Color="#05061726" Offset="0.62" />
                            <GradientStop Color="#52061726" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            MaxWidth="420"
                            Padding="24,22,24,20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#B8F8FBFF"
                            BorderBrush="#9EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="26">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Direction="270"
                                              Opacity="0.10"
                                              ShadowDepth="5"
                                              Color="#FF102A43" />
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="{Binding AppTitle}"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="39"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding Subtitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="22,18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="#9AF8FBFF"
                            BorderBrush="#8CFFFFFF"
                            BorderThickness="1"
                            CornerRadius="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Direction="270"
                                              Opacity="0.10"
                                              ShadowDepth="5"
                                              Color="#FF102A43" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,18,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding StatusMessage}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Content="{Binding StartLessonButtonText}"
                                        Command="{Binding StartLessonCommand}"
                                        Width="170"
                                        Height="44"
                                        Margin="0,0,12,0"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="{Binding SettingsButtonText}"
                                        Command="{Binding OpenSettingsCommand}"
                                        Width="140"
                                        Height="44"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
