<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="760"
                Padding="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MainContentCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding AppTitle}"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Subtitle}"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,30,0,0"
                        Height="250"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{StaticResource BorderAccentSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerTile}"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F7FBFF" Offset="0" />
                            <GradientStop Color="#E8F1FF" Offset="0.48" />
                            <GradientStop Color="#F5ECFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Ellipse Width="260"
                                 Height="260"
                                 Margin="-70,-110,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Fill="#42FFD9A8" />
                        <Ellipse Width="320"
                                 Height="320"
                                 Margin="0,-150,-85,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="#3D8DB9FF" />
                        <Ellipse Width="280"
                                 Height="280"
                                 Margin="0,0,70,-190"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="#34BDA8FF" />

                        <Canvas HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="500"
                                Height="168">
                            <Path Stroke="#376A8FB8"
                                  StrokeThickness="2"
                                  StrokeDashArray="6 8"
                                  Data="M 20,92 C 140,8 330,8 480,86" />
                            <Path Stroke="#2F5CA98A"
                                  StrokeThickness="2"
                                  StrokeDashArray="5 7"
                                  Data="M 60,132 C 175,72 315,70 440,118" />
                            <Border Canvas.Left="54"
                                    Canvas.Top="38"
                                    Width="148"
                                    Height="66"
                                    Padding="14"
                                    Background="#DDFFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="22">
                                <StackPanel>
                                    <Rectangle Height="8" Width="78" RadiusX="4" RadiusY="4" Fill="#8FA9C8" HorizontalAlignment="Left" />
                                    <Rectangle Margin="0,11,0,0" Height="8" Width="112" RadiusX="4" RadiusY="4" Fill="#BCD0E6" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="278"
                                    Canvas.Top="22"
                                    Width="170"
                                    Height="78"
                                    Padding="16"
                                    Background="#D8FFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="24">
                                <StackPanel>
                                    <Rectangle Height="8" Width="98" RadiusX="4" RadiusY="4" Fill="#7EA68F" HorizontalAlignment="Left" />
                                    <Rectangle Margin="0,12,0,0" Height="8" Width="128" RadiusX="4" RadiusY="4" Fill="#B8D7C6" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="178"
                                    Canvas.Top="104"
                                    Width="178"
                                    Height="64"
                                    Padding="15"
                                    Background="#CCFFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="22">
                                <StackPanel>
                                    <Rectangle Height="8" Width="116" RadiusX="4" RadiusY="4" Fill="#A38ACB" HorizontalAlignment="Left" />
                                    <Rectangle Margin="0,11,0,0" Height="8" Width="82" RadiusX="4" RadiusY="4" Fill="#CFC2E8" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,30,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="{Binding StartLessonButtonText}"
                            Command="{Binding StartLessonCommand}"
                            Width="170"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{Binding SettingsButtonText}"
                            Command="{Binding OpenSettingsCommand}"
                            Width="140"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,16,0,0"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
