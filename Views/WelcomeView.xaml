<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="760"
                Padding="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MainContentCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding AppTitle}"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Subtitle}"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,30,0,0"
                        Height="250"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{StaticResource BorderAccentSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerTile}"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Welcome/welcome-cover.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,30,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="{Binding StartLessonButtonText}"
                            Command="{Binding StartLessonCommand}"
                            Width="170"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{Binding SettingsButtonText}"
                            Command="{Binding OpenSettingsCommand}"
                            Width="140"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,16,0,0"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
