<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
            <Border Width="540"
                Height="640"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderAccentSoftBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerContainer}"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="12"
                                  Color="#FF173B57" />
            </Border.Effect>

            <Grid>
                <Image Source="/Assets/Welcome/welcome-cover.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       SnapsToDevicePixels="True" />

                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3F061726" Offset="0" />
                            <GradientStop Color="#10061726" Offset="0.42" />
                            <GradientStop Color="#05061726" Offset="0.62" />
                            <GradientStop Color="#52061726" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="24,14,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Width="452"
                            Padding="18,11,18,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#B8F8FBFF"
                            BorderBrush="#9EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Direction="270"
                                              Opacity="0.10"
                                              ShadowDepth="5"
                                              Color="#FF102A43" />
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="{Binding AppTitle}"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="28"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Subtitle}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       LineHeight="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Width="452"
                            Padding="18,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#9AF8FBFF"
                            BorderBrush="#8CFFFFFF"
                            BorderThickness="1"
                            CornerRadius="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Direction="270"
                                              Opacity="0.10"
                                              ShadowDepth="5"
                                              Color="#FF102A43" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Stretch"
                                       Text="{Binding StatusMessage}"
                                       TextAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Grid.Row="1"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Content="{Binding StartLessonButtonText}"
                                        Command="{Binding StartLessonCommand}"
                                        Height="44"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="3"
                                        Content="{Binding SettingsButtonText}"
                                        Command="{Binding OpenSettingsCommand}"
                                        Height="44"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
