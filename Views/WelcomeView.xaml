<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="720"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MainContentCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding AppTitle}"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center" />

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Border Margin="0,28,0,0"
                        Padding="20"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderAccentSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding HowItWorksTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding ChooseTopicStep}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding PracticeStep}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding CorrectionsStep}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,30,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="{Binding StartLessonButtonText}"
                            Command="{Binding StartLessonCommand}"
                            Width="170"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{Binding SettingsButtonText}"
                            Command="{Binding OpenSettingsCommand}"
                            Width="140"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock Margin="0,16,0,0"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,24,0,0"
                           Text="{Binding FooterNote}"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
