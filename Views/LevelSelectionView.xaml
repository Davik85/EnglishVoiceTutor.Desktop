<UserControl x:Class="EnglishVoiceTutor.Desktop.Views.LevelSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Border MaxWidth="720"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource CornerLarge}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="#FF1C2B3A"
                           TextAlignment="Center" />

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="16"
                           Foreground="#FF3A4A5B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <ItemsControl Margin="0,24,0,0" ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.SelectLevelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource LevelOptionButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{Binding ContinueButtonText}"
                        Command="{Binding ContinueCommand}"
                        Margin="0,12,0,0"
                        Width="140"
                        Height="42"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button Content="{Binding BackButtonText}"
                        Command="{Binding BackCommand}"
                        Margin="0,10,0,0"
                        Width="140"
                        Height="42"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <TextBlock Margin="0,16,0,0"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="#FF3A4A5B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
